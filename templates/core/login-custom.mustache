    {{! @template core/login Moodle template for the login page. }}
    {{! Esta es una plantilla para el inicio de sesión personalizado }}
    
    {{> theme_inteb/head }}
    
    <body {{{ bodyattributes }}} style="{{loginbackground}}">
        <section class="vh-100" role="main">
                <div class="row h-100">
                    <!-- Carrusel de Imágenes (Columna Izquierda - col-lg-8) -->
                    <div class="col-lg-8 px-0 d-none d-lg-block">
                        <div id="loginCarousel" class="carousel slide h-100" data-ride="carousel" data-interval="{{carouselinterval}}"
                            aria-label="{{#str}}carousel, theme_inteb{{/str}}">
                            <div class="carousel-inner h-100">
                                {{#carouselimages}}
                                <div class="carousel-item {{#first}}active{{/first}} h-100">
                                    <a href="{{button_url}}" target="_blank">
                                        <img src="{{url}}" alt="{{title}}" class="d-block w-100 h-100" style="object-fit: cover; border-radius: 0;">
                                    </a>
                                </div>
                                {{/carouselimages}}
                            </div>
                            <a class="carousel-control-prev" href="#loginCarousel" role="button" data-slide="prev"
                                aria-label="{{#str}}previous, theme_inteb{{/str}}">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="sr-only">{{#str}}previous, theme_inteb{{/str}}</span>
                            </a>
                            <a class="carousel-control-next" href="#loginCarousel" role="button" data-slide="next"
                                aria-label="{{#str}}next, theme_inteb{{/str}}">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="sr-only">{{#str}}next, theme_inteb{{/str}}</span>
                            </a>
                        </div>
                    </div>
    
                    <!-- Formulario de Login (Columna Derecha - col-lg-4) -->
                    <div class="col-lg-4 d-flex flex-column justify-content-center align-items-center text-black px-4">
                        <div class="w-100">
   
                            <!-- Formulario de Login Centrando Verticalmente -->
                            <div class="d-flex flex-column justify-content-center align-items-center">
                                {{> theme_inteb/loginbox }}
                            </div>
                        </div>
                    </div>
                </div>
    
                <div class="row justify-content-center my-3 my-footer-wrapper">
                    <div class="my-footer panel col-12">
                        <div class="card my-footer panel fixed-bottom">
                            <div class="card-block">
                                <div class="copyright">
                                    <div class="row justify-content-center my-credit-footer-wrapper">
                                        <div class="col-12 col-md-12 col-lg-8 col-xlg-6">
                                            <div class="panel text-center my-credit">
                                                <small class="text-muted-footer" id="my-credit">{{{my_credit}}}</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

    
            <!-- Scripts de jQuery y Bootstrap -->
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
            <script>
                document.addEventListener("DOMContentLoaded", function() {
                    $('#loginCarousel').carousel({
                        interval: {{carouselinterval}} // Tiempo en milisegundos
                    });
                });
            </script>
            <div class="d-none">
                {{{ output.standard_footer_html }}}
                {{{ output.standard_end_of_body_html }}}
            </div>
        </section>
    </body>
    