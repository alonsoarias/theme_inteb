    "", "logourl": false, "sitename": "Beer & Chips" } }}
    {{! Esta es una plantilla para el inicio de sesión personalizado }}

    {{> theme_inteb/head }}

    <body {{{ bodyattributes }}} style="{{loginbackground}}">
        <section class="vh-100" role="main">
            <div class="container h-100">
                <!-- Contenido exclusivo para móviles -->
                <div class="d-block d-lg-none w-100">
                    <div class="card shadow-lg my-auto" style="border-radius: 1rem; background-color: white;">
                        <div class="container" style="padding: 15px;">
                            <!-- Logo sobre el carrusel -->
                            {{#logourl}}
                            <div class="login-logo text-center">
                                <img src="{{logourl}}" alt="Site Logo" class="mb-3" style="width: 100%; margin-top: 5%;">
                            </div>
                            {{/logourl}}
                            <!-- Carrusel -->
                            <div class="card" style="border-radius: 24px;">
                                <div id="loginCarouselMobile" class="carousel slide justify-content-center align-items-center"
                                    data-ride="carousel" data-interval="{{carouselinterval}}"
                                    aria-label="{{#str}}carousel, theme_inteb{{/str}}">
                                    <div class="carousel-inner" role="listbox">
                                        {{#carouselimages}}
                                        <div class="carousel-item {{#first}}active{{/first}}" aria-label="{{title}}">
                                            <a href="{{button_url}}" target="_blank">
                                                <img src="{{url}}" alt="{{title}}" class="d-block w-100"
                                                    style="object-fit: cover; border-radius: 24px;">
                                            </a>
                                        </div>
                                        {{/carouselimages}}
                                    </div>
                                    <a class="carousel-control-prev" href="#loginCarouselMobile" role="button"
                                        data-slide="prev" aria-label="{{#str}}previous, theme_inteb{{/str}}">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="sr-only">{{#str}}previous, theme_inteb{{/str}}</span>
                                    </a>
                                    <a class="carousel-control-next" href="#loginCarouselMobile" role="button"
                                        data-slide="next" aria-label="{{#str}}next, theme_inteb{{/str}}">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="sr-only">{{#str}}next, theme_inteb{{/str}}</span>
                                    </a>
                                </div>
                            </div>
                            <!-- Formulario de login -->
                            <div class="login-welcome-wrapper d-flex flex-column flex-gap-1 text-center">
                                <h2 class="h-bold-3 m-3">
                                    {{#str}}welcometobrand, theme_remui, {{sitename}}{{/str}}
                                </h2>
                                <p class="para-regular-3 m-0">{{#str}}entertologin, theme_remui{{/str}}</p>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center"
                                style="padding: 1rem;">
                                {{> theme_inteb/loginbox_mobile }}
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Contenido exclusivo para desktop -->
                <div class="row d-none d-lg-flex justify-content-center align-items-center h-100">
                    <!-- Formulario de login -->
                    <div class="col-md-8 col-lg-4">
                        <div class="card" style="border-radius: 1rem;">
                            <div class="card-body d-flex align-items-center justify-content-center" style="padding: 1rem;"
                                aria-label="{{#str}}loginsection, theme_inteb{{/str}}">
                                {{> theme_inteb/loginbox_desktop }}
                            </div>
                        </div>
                    </div>
                    <!-- Carrusel de imágenes -->
                    <div class="col-md-8 col-lg-8">
                        <div class="card" style="border-radius: 24px;">
                            <div id="loginCarouselDesktop" class="carousel slide justify-content-center align-items-center"
                                data-ride="carousel" data-interval="{{carouselinterval}}"
                                aria-label="{{#str}}carousel, theme_inteb{{/str}}">
                                <div class="carousel-inner" role="listbox">
                                    {{#carouselimages}}
                                    <div class="carousel-item {{#first}}active{{/first}}" aria-label="{{title}}">
                                        <a href="{{button_url}}" target="_blank">
                                            <img src="{{url}}" alt="{{title}}" class="d-block w-100"
                                                style="object-fit: cover; border-radius: 24px;">
                                        </a>
                                    </div>
                                    {{/carouselimages}}
                                </div>
                                <a class="carousel-control-prev" href="#loginCarouselDesktop" role="button"
                                    data-slide="prev" aria-label="{{#str}}previous, theme_inteb{{/str}}">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="sr-only">{{#str}}previous, theme_inteb{{/str}}</span>
                                </a>
                                <a class="carousel-control-next" href="#loginCarouselDesktop" role="button"
                                    data-slide="next" aria-label="{{#str}}next, theme_inteb{{/str}}">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="sr-only">{{#str}}next, theme_inteb{{/str}}</span>
                                </a>
                            </div>
                        </div>    
                    </div>
                </div>
                <div class="row justify-content-center my-3 my-footer-wrapper">
                    <div class="my-footer panel col-12">
                        <div class="card my-footer panel fixed-bottom">
                            <div class="card-block">
                                <div class="copyright">
                                    <div class="row justify-content-center my-credit-footer-wrapper">
                                        <div class="col-12 col-md-12 col-lg-8 col-xlg-6">
                                            <div class="panel text-center my-credit">
                                                <small class="text-muted-footer" id="my-credit">{{{my_credit}}}</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Scripts de jQuery y Bootstrap -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function() {
        $('#loginCarousel').carousel({
            interval: {{carouselinterval}} // Tiempo en milisegundos
        });
        $('#loginCarouselDesktop').carousel({
            interval: {{carouselinterval}} // Tiempo en milisegundos para escritorio
        });
    });
    </script>
    <div class="d-none">
        {{{ output.standard_footer_html }}}
        {{{ output.standard_end_of_body_html }}}
    </div>
</body>
