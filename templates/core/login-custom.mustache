{{! @template core/login Moodle template para la página de inicio de sesión. }}
{{! Esta es una plantilla para el inicio de sesión personalizado }}

{{! Este archivo es parte de Moodle - http://moodle.org/ }}

<body {{{ bodyattributes }}} style="{{loginbackground}}">
    <section class="d-flex flex-column">
            <div class="row">
                <!-- Carrusel de Imágenes (Columna Izquierda) -->
                <div class="col-12 col-sm-12 col-md-8 col-lg-8 col-xl-8 px-0 d-none d-md-block">
                    <div id="loginCarousel" class="carousel slide" data-ride="carousel" data-interval="{{carouselinterval}}"
                        aria-label="{{#str}}carousel, theme_inteb{{/str}}">
                        <div class="carousel-inner">
                            {{#carouselimages}}
                            <div class="carousel-item {{#first}}active{{/first}}">
                                <a href="{{button_url}}" target="_blank">
                                    <img src="{{url}}" alt="{{title}}" class="d-block vh-100" style="object-fit: cover; border-radius: 0;">
                                    <div class="carousel-caption d-none d-md-block">
                                        <h5>{{title}}</h5>
                                        <p>{{description}}</p>
                                        <div class="carousel-controls">
                                            <!-- Indicadores del Carrusel -->
                                            <ol class="carousel-indicators">
                                                {{#carouselimages}}
                                                <li data-target="#loginCarousel" data-slide-to="{{index}}" {{#first}}class="active"{{/first}}></li>
                                                {{/carouselimages}}
                                            </ol>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            {{/carouselimages}}
                        </div>
                    </div>
                </div>

                <!-- Formulario de Login (Columna Derecha) -->
                <div class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 d-flex flex-column justify-content-center align-items-center text-black vh-100">
                    <div class="login-wrapper">
                        <div class="d-flex flex-column justify-content-center align-items-center">
                            {{> theme_inteb/loginbox }}
                        </div>
                    </div>
                </div>
            </div>

        <div class="row justify-content-center my-footer-wrapper">
            <div class="my-footer panel col-12">
                <div class="card my-footer panel fixed-bottom">
                    <div class="card-block">
                        <div class="copyright">
                            <div class="row justify-content-center my-credit-footer-wrapper">
                                <div class="col-12 col-md-12 col-lg-8 col-xlg-6">
                                    <div class="panel text-center my-credit">
                                        <small class="text-muted-footer" id="my-credit">{{{my_credit}}}</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scripts de jQuery y Bootstrap -->
        <script src="https://code.jquery.com/jquery-4.6.0.min.js"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                $('#loginCarousel').carousel({
                    interval: {{carouselinterval}}
                });
            });
        </script>

        <div class="d-none">
            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
        </div>
    </section>
</body>