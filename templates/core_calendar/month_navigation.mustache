{{!
    @template core_calendar/month_navigation

    Month navigation - Modernized and fully functional
}}
<div id="month-navigation-{{uniqid}}-{{calendarinstanceid}}" class="controls inteb-month-nav">
    <!-- Desktop Navigation -->
    <div class="calendar-controls mainarea-view inteb-nav-desktop">
        <a href="{{previousperiodlink}}"
           class="edw-icon-container arrow_link previous inteb-nav-arrow"
           title="{{#str}}monthprev, calendar{{/str}}"
           data-year="{{previousperiod.year}}"
           data-month="{{previousperiod.mon}}"
           data-drop-zone="nav-link"
           aria-label="{{previousperiodname}}">
            <i class="fa fa-chevron-left"></i>
            <span class="sr-only">{{previousperiodname}}</span>
        </a>
        
        <div class="inteb-month-display">
            <h4 class="current para-semibold-2 mb-0">
                <i class="fa fa-calendar inteb-cal-icon"></i>
                <span>{{periodname}}</span>
            </h4>
        </div>
        
        <a href="{{nextperiodlink}}"
           class="edw-icon-container arrow_link next inteb-nav-arrow"
           title="{{#str}}monthnext, calendar{{/str}}"
           data-year="{{nextperiod.year}}"
           data-month="{{nextperiod.mon}}"
           data-drop-zone="nav-link"
           aria-label="{{nextperiodname}}">
            <i class="fa fa-chevron-right"></i>
            <span class="sr-only">{{nextperiodname}}</span>
        </a>
    </div>
    
    <!-- Mobile Navigation -->
    <div class="calendar-controls sidebar-view inteb-nav-mobile">
        <h4 class="current h-semibold-5 mb-0">{{periodname}}</h4>
        <div class="d-flex flex-gap-1">
            <a href="{{previousperiodlink}}"
               class="edw-icon-container arrow_link previous"
               title="{{#str}}monthprev, calendar{{/str}}"
               data-year="{{previousperiod.year}}"
               data-month="{{previousperiod.mon}}"
               data-drop-zone="nav-link">
                <i class="fa fa-arrow-left"></i>
            </a>
            <a href="{{nextperiodlink}}"
               class="edw-icon-container arrow_link next"
               title="{{#str}}monthnext, calendar{{/str}}"
               data-year="{{nextperiod.year}}"
               data-month="{{nextperiod.mon}}"
               data-drop-zone="nav-link">
                <i class="fa fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

{{#js}}
require(['jquery', 'core_calendar/month_navigation_drag_drop'], function($, DragDrop) {
    var root = $('#month-navigation-{{uniqid}}-{{calendarinstanceid}}');
    DragDrop.init(root);
    
    // Navigation pills functionality
    $('[data-action="navigate-month"]').on('click', function(e) {
        e.preventDefault();
        
        var $this = $(this);
        var month = $this.data('month');
        var year = $this.data('year');
        
        // Add loading state
        $this.addClass('loading');
        
        // Get current view parameters
        var urlParams = new URLSearchParams(window.location.search);
        var view = urlParams.get('view') || 'month';
        var courseId = urlParams.get('course') || '';
        var categoryId = urlParams.get('categoryid') || '';
        
        // Build URL
        var url = M.cfg.wwwroot + '/calendar/view.php?';
        var params = [];
        
        params.push('view=' + view);
        params.push('cal_y=' + year);
        params.push('cal_m=' + month);
        
        if (courseId) {
            params.push('course=' + courseId);
        }
        if (categoryId) {
            params.push('categoryid=' + categoryId);
        }
        
        url += params.join('&');
        
        // Navigate
        window.location.href = url;
    });
    
    // Add smooth transition effect on navigation
    $('.inteb-nav-arrow').on('click', function(e) {
        $(this).addClass('loading');
        $('.inteb-month-nav').addClass('transitioning');
    });
});
{{/js}}
