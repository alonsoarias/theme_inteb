{{!
    @template core_calendar/floating_add_button

    Floating action button for adding events
}}
{{#defaulteventcontext}}
<div class="inteb-fab-container">
    <button class="inteb-fab"
            data-context-id="{{defaulteventcontext}}"
            data-action="new-event-button"
            aria-label="{{#str}}newevent, core_calendar{{/str}}"
            title="{{#str}}newevent, core_calendar{{/str}}">
        <i class="fa fa-plus"></i>
        <span class="inteb-fab-label">{{#str}}newevent, core_calendar{{/str}}</span>
    </button>
</div>
{{/defaulteventcontext}}