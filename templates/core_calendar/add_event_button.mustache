{{!
    @template core_calendar/add_event_button

    Add event button - Modernized and fully functional
}}
{{#defaulteventcontext}}
<button class="btn btn-primary inteb-add-event-btn"
        data-context-id="{{defaulteventcontext}}"
        data-action="new-event-button">
    <i class="fa fa-plus"></i>
    <span class="d-none d-sm-inline">{{#str}}newevent, core_calendar{{/str}}</span>
    <span class="d-sm-none">{{#str}}add{{/str}}</span>
</button>
{{/defaulteventcontext}}
